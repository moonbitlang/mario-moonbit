package "mario/core/object"

import(
  "mario/core/utils"
  "mario/game/actors"
  "mario/rendering/sprite"
  "moonbitlang/core/list"
)

// Values
fn check_collision(Collidable, Collidable) -> @utils.Dir2d?

fn collide_block(Bool, @utils.Dir2d, Object) -> Unit

fn dec_health(Object) -> Unit

fn evolve_block(Object) -> Collidable

fn evolve_enemy(@utils.Dir1d, @actors.Enemy, @sprite.Sprite, Object) -> Collidable?

fn kill(Collidable) -> @list.T[@sprite.Particle]

fn process_obj(Object, Double) -> Unit

fn rev_dir(Object, @actors.Enemy, @sprite.Sprite) -> Unit

fn reverse_left_right(Object) -> Unit

fn spawn(@actors.Spawn, Double, Double) -> Collidable

fn spawn_above(@utils.Dir1d, Object, @actors.Item) -> Collidable

fn update_player(Collidable, @list.T[Control]) -> Collidable?

// Types and methods
pub struct Collidable {
  target : @actors.Spawn
  sprite : @sprite.Sprite
  object : Object
}
impl Eq for Collidable

pub(all) enum Control {
  Left
  Right
  Up
  Down
}

pub(all) struct Object {
  params : ObjectParams
  pos : @utils.XY
  vel : @utils.XY
  id : Int
  mut jumping : Bool
  mut grounded : Bool
  mut dir : @utils.Dir1d
  mut invuln : Int
  mut kill : Bool
  mut health : Int
  mut crouch : Bool
  mut score : Int
}

type ObjectParams

