package "mario/game/actors"

// Values

// Types and methods
pub(all) enum Block {
  QBlock(Item)
  QBlockUsed
  Brick
  UnBBlock
  Cloud
  Panel
  Ground
}

pub(all) enum Enemy {
  Goomba
  GKoopa
  RKoopa
  GKoopaShell
  RKoopaShell
}

pub(all) enum Item {
  Mushroom
  Coin
}

pub(all) enum Player {
  Standing
  Jumping
  Running
  Crouching
}

pub(all) enum PlayerSize {
  Small
  Large
}

pub(all) enum Spawn {
  Player(PlayerSize, Player)
  Enemy(Enemy)
  Item(Item)
  Block(Block)
}

