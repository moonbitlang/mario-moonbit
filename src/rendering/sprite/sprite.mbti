package "mario/rendering/sprite"

import(
  "mario/core/utils"
  "mario/game/actors"
)

// Values
fn make_bgd() -> Sprite

// Types and methods
type Image

pub(all) enum Part {
  GoombaSquish
  BrickChunkL
  BrickChunkR
  Score100
  Score200
  Score400
  Score800
  Score1000
  Score2000
  Score4000
  Score8000
}

pub struct Particle {
  params : ParticleParams
  pos : @utils.XY
  mut kill : Bool
  // private fields
}
fn Particle::make(@utils.XY, @utils.XY, Part, @utils.XY) -> Self
fn Particle::make_score(Int, @utils.XY) -> Self
fn Particle::process(Self) -> Unit

pub struct ParticleParams {
  sprite : Sprite
  // private fields
}

pub struct Sprite {
  mut params : SpriteParams
  mut frame : Int
  mut img : Image
  // private fields
}
fn Sprite::make(@actors.Spawn, @utils.Dir1d) -> Self
fn Sprite::transform_enemy(Self, @actors.Enemy, @utils.Dir1d) -> Unit
fn Sprite::update_animation(Self) -> Unit

pub struct SpriteParams {
  frame_size : (Double, Double)
  src_offset : (Double, Double)
  bbox_offset : (Double, Double)
  bbox_size : (Double, Double)
  // private fields
}

